# Frontend password. Users must log in with this password before using pages and APIs from the pages.
FRONTEND_PASSWORD=change_me_to_a_random_string
# Optional signing secret for frontend login tokens. Defaults to FEISHU_APP_SECRET if unset.
# FRONTEND_SESSION_SECRET=change_me_to_another_random_string
# Optional token TTL in seconds. Default: 604800 (7 days).
# FRONTEND_TOKEN_TTL_SECONDS=604800

# Optional legacy API key. Direct API requests may still use X-API-Key.
# If FRONTEND_PASSWORD is empty, this also becomes the frontend login password.
SERVICE_API_KEY=change_me_to_a_random_string

# Feishu app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# Feishu Bitable target for cleaned XHS links
FEISHU_BITABLE_APP_TOKEN=base_xxxxxxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxxxxxxx
FEISHU_FIELD_NAME=小红书链接

# text or url. Use text first if unsure.
FEISHU_FIELD_TYPE=text

# Optional fields for cleaned XHS links
# FEISHU_ORIGINAL_URL_FIELD=原始链接
# FEISHU_XHS_ID_FIELD=小红书ID
# FEISHU_SUBMITTED_AT_FIELD=提交时间

# Feishu Bitable source for existing XHS note content table
FEISHU_NOTES_BITABLE_APP_TOKEN=base_xxxxxxxxxxxxx
FEISHU_NOTES_TABLE_ID=tblxxxxxxxxxxxxx
FEISHU_NOTES_TITLE_FIELD=标题
FEISHU_NOTES_BODY_FIELD=正文
FEISHU_NOTES_TAGS_FIELD=标签
FEISHU_NOTES_IMAGE_FIELD=图片
FEISHU_NOTES_FETCHED_FIELD=是否拉取
FEISHU_NOTES_CATEGORY_FIELD=笔记类别
FEISHU_NOTES_FETCHED_YES_VALUE=是

# Feishu Bitable target for uploaded extracted webpage note content
FEISHU_EXTRACT_BITABLE_APP_TOKEN=base_xxxxxxxxxxxxx
FEISHU_EXTRACT_TABLE_ID=tblxxxxxxxxxxxxx
FEISHU_EXTRACT_TITLE_FIELD=标题
FEISHU_EXTRACT_BODY_FIELD=正文
FEISHU_EXTRACT_TAGS_FIELD=标签
FEISHU_EXTRACT_IMAGE_FIELD=图片链接

# Optional XHS extraction tuning: request body also supports timeout_ms/settle_ms/scroll_times. upload_images/max_images are kept for API compatibility but image URLs are written directly.
